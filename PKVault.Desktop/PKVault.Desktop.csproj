<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <PublishTrimmed>true</PublishTrimmed>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Can be enabled temporarily to investigate trimming warnings. -->
    <!-- <EnableTrimAnalyzer>true</EnableTrimAnalyzer> -->

    <!-- Suppresses known trimming warnings from ASP.NET Core MVC, EF Core, etc. -->
    <NoWarn>$(NoWarn);IL2026;IL2037;IL2104</NoWarn>

    <RuntimeIdentifiers>
      win-x64;
      win-arm64;
      linux-x64;
      linux-arm64;
      osx-x64;
      osx-arm64
    </RuntimeIdentifiers>

    <AssemblyName>PKVault</AssemblyName>
    <ApplicationTitle>PKVault</ApplicationTitle>
    <ApplicationId>com.chnapy.pkvault</ApplicationId>

    <!-- Must exist at PKVault.Desktop/Resources/wwwroot/icon.ico. -->
    <ApplicationIcon>Resources\wwwroot\icon.ico</ApplicationIcon>

    <Product>PKVault</Product>
    <Description>PKVault is a Pokemon storage and save manipulation tool based on PKHeX.</Description>
    <AssemblyDescription>PKVault is a Pokemon storage and save manipulation tool based on PKHeX.</AssemblyDescription>

    <!-- Required by ManifestEmbeddedFileProvider. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Recovered wwwroot files may contain files that were accidentally
      given a .cs extension during extraction. Do not treat them as code.
    -->
    <Compile Remove="Resources\wwwroot\**\*.cs" />

    <!--
      Embed the complete recovered frontend bundle into PKVault.dll.
      This includes HTML, CSS, JS, PNG/SVG images, fonts, icons,
      JSON files, and any extracted resource with an unusual extension.
    -->
    <EmbeddedResource Include="Resources\wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="linker.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Photino.NET.Server" Version="4.0.12" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
    <PackageReference Include="GtkSharp" Version="3.24.24.95" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PKVault.Core\PKVault.Core.csproj" />
  </ItemGroup>

</Project>
